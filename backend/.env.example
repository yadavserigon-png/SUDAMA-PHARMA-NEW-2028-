# ===== Sudama Pharma API - copy to .env and fill in. NEVER commit .env =====
NODE_ENV=development
PORT=5000

# Separate database for the NEW platform only
MONGODB_URI=mongodb://127.0.0.1:27017/sudama_pharma_platform

# Long random string (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# One-time secret used by the web "first-time setup" page to create the Super Admin.
# Choose a random value, use it once, then remove it.
SETUP_TOKEN=

# Frontend URL(s) allowed to call the API (comma separated)
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:5000
# true when running behind Render/Railway/Nginx (correct client IPs for rate limiting)
TRUST_PROXY=false

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
LOCATION_RETENTION_DAYS=7

# ----- PhonePe Payment Gateway (fill after merchant onboarding) -----
# v2 = Standard Checkout with OAuth client credentials (issued to new merchants). v1 = legacy salt-key API.
PHONEPE_API_VERSION=v2
# UAT (sandbox) or PROD
PHONEPE_ENV=UAT
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
# Username/password you set for the webhook in the PhonePe business dashboard
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
# Only for legacy v1 accounts:
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1

# ----- WhatsApp Business Platform / Cloud API (fill after Meta verification) -----
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_BUSINESS_NUMBER=919264289295

# ----- Optional SMS/email relay for OTP + password reset codes -----
MESSAGING_WEBHOOK_URL=
MESSAGING_WEBHOOK_SECRET=
